# Copy this file to .env and fill in real values. Never commit .env.
# Variable names only, no real keys here.

# ElevenLabs text-to-speech. Server only: no VITE_ prefix, so it never reaches the browser.
ELEVENLABS_API_KEY=
# Optional: your own voices, comma-separated. Leave empty to use the built-in ones.
ELEVENLABS_VOICE_IDS=

# YouTube Data API v3, for real Shorts. Server only.
YOUTUBE_API_KEY=

# Gemini, for making flashcards. Server only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Online only: the site's Render address, so the server accepts its requests.
ALLOWED_ORIGIN=

# Online only, browser: the server's Render address. Leave empty locally.
VITE_API_URL=
